<%- include('_head', { title, page, user, csrfToken }) %>

<% if (flash) { %>
<div class="alert alert-<%= flash.type === 'success' ? 'success' : 'error' %>">
  <i class="fa-solid fa-<%= flash.type === 'success' ? 'circle-check' : 'circle-exclamation' %>"></i>
  <%= flash.msg %>
</div>
<% } %>

<div class="section-header">
  <div>
    <div class="filter-tabs">
      <a href="/admin/properties" class="filter-tab <%= filter === 'all' ? 'active' : '' %>">All</a>
      <a href="/admin/properties?status=available" class="filter-tab <%= filter === 'available' ? 'active' : '' %>">Available</a>
      <a href="/admin/properties?status=under-offer" class="filter-tab <%= filter === 'under-offer' ? 'active' : '' %>">Under Offer</a>
      <a href="/admin/properties?status=sold" class="filter-tab <%= filter === 'sold' ? 'active' : '' %>">Sold</a>
      <a href="/admin/properties?status=rented" class="filter-tab <%= filter === 'rented' ? 'active' : '' %>">Rented</a>
    </div>
  </div>
  <a href="/admin/properties/new" class="btn btn-primary">
    <i class="fa-solid fa-plus"></i> Add Property
  </a>
</div>

<% if (properties.length === 0) { %>
<div class="table-wrap">
  <div class="empty-state">
    <i class="fa-solid fa-house"></i>
    <p>No properties found. <a href="/admin/properties/new">Add your first listing &rarr;</a></p>
  </div>
</div>
<% } else { %>
<div class="table-wrap">
  <table class="data-table">
    <thead>
      <tr>
        <th style="width:70px;">Photo</th>
        <th>Title &amp; Location</th>
        <th>Price</th>
        <th>Type</th>
        <th>Status</th>
        <th style="width:60px;text-align:center;">Featured</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% properties.forEach(p => { %>
      <tr>
        <td>
          <% if (p.coverImage) { %>
            <img src="<%= /^https?:\/\//i.test(p.coverImage) ? p.coverImage : '/' + p.coverImage %>" alt="<%= p.title %>" class="tbl-thumb">
          <% } else { %>
            <div class="tbl-thumb-ph" aria-label="No photo">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="3" y="4" width="18" height="16" rx="2" stroke="currentColor" stroke-width="1.6"/>
                <circle cx="8.5" cy="9.5" r="1.5" stroke="currentColor" stroke-width="1.6"/>
                <path d="M21 16l-5.5-5.5a1.5 1.5 0 0 0-2.12 0L4 19" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
              </svg>
            </div>
          <% } %>
        </td>
        <td>
          <strong><%= p.title %></strong>
          <div style="font-size:11.5px;color:var(--gray-mid);margin-top:2px;">
            <i class="fa-solid fa-location-dot" style="font-size:10px;"></i> <%= p.location %>
          </div>
          <div style="font-size:10.5px;color:var(--gray-mid);margin-top:1px;">/<%= p.slug %></div>
        </td>
        <td>
          <strong>N$<%= Number(p.price).toLocaleString() %></strong>
          <% if (p.levy) { %><div style="font-size:11.5px;color:var(--gray-mid);">Levy: N$<%= p.levy %>/mo</div><% } %>
        </td>
        <td>
          <span class="badge" style="background:rgba(32,99,224,.08);color:var(--blue-mid);border:1px solid rgba(32,99,224,.15);">
            <%= p.type === 'sale' ? 'For Sale' : 'To Rent' %>
          </span>
        </td>
        <td><span class="badge badge-<%= p.status %>"><%= p.status %></span></td>
        <td style="text-align:center;">
          <button class="star-btn <%= p.featured ? 'active' : '' %>"
                  data-id="<%= p.id %>"
                  data-csrf="<%= csrfToken %>"
                  onclick="toggleFeatured(this)"
                  title="<%= p.featured ? 'Remove from featured' : 'Mark as featured' %>">
            <i class="fa-solid fa-star"></i>
          </button>
        </td>
        <td>
          <div class="actions-cell">
            <a href="/admin/properties/<%= p.id %>/edit" class="btn btn-sm btn-outline">
              <i class="fa-solid fa-pen"></i> Edit
            </a>
            <form method="POST" action="/admin/properties/<%= p.id %>/delete"
                  onsubmit="return confirm('Delete \'<%= p.title %>\'? This cannot be undone.')">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="btn btn-sm btn-danger">
                <i class="fa-solid fa-trash"></i>
              </button>
            </form>
          </div>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<% if (totalPages > 1) { %>
<div class="admin-pagination">
  <a href="/admin/properties?status=<%= filter === 'all' ? '' : filter %>&page=<%= Math.max(1, currentPage - 1) %>"
     class="btn btn-sm btn-outline"
     <% if (currentPage === 1) { %>style="opacity:.35;pointer-events:none;"<% } %>>
    <i class="fa-solid fa-chevron-left"></i> Prev
  </a>
  <% for (let i = 1; i <= totalPages; i++) { %>
  <a href="/admin/properties?status=<%= filter === 'all' ? '' : filter %>&page=<%= i %>"
     class="filter-tab <%= i === currentPage ? 'active' : '' %>"><%= i %></a>
  <% } %>
  <a href="/admin/properties?status=<%= filter === 'all' ? '' : filter %>&page=<%= Math.min(totalPages, currentPage + 1) %>"
     class="btn btn-sm btn-outline"
     <% if (currentPage === totalPages) { %>style="opacity:.35;pointer-events:none;"<% } %>>
    Next <i class="fa-solid fa-chevron-right"></i>
  </a>
</div>
<% } %>
<% } %>

<script>
async function toggleFeatured(btn) {
  const id       = btn.dataset.id;
  const csrf     = btn.dataset.csrf;
  const wasActive = btn.classList.contains('active');

  // Optimistic UI: flip immediately, revert only if the request fails
  btn.classList.toggle('active', !wasActive);
  btn.title = !wasActive ? 'Remove from featured' : 'Mark as featured';
  btn.disabled = true;

  try {
    const res = await fetch(`/admin/properties/${id}/toggle-featured`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/x-www-form-urlencoded',
        'X-CSRF-Token': csrf,
      },
      body: `_csrf=${encodeURIComponent(csrf)}`,
    });
    if (!res.ok) throw new Error('request failed');
    const data = await res.json();
    if (data.featured === undefined) throw new Error('unexpected response');
    btn.classList.toggle('active', data.featured === 1);
    btn.title = data.featured ? 'Remove from featured' : 'Mark as featured';
  } catch (e) {
    btn.classList.toggle('active', wasActive);
    btn.title = wasActive ? 'Remove from featured' : 'Mark as featured';
  } finally {
    btn.disabled = false;
  }
}
</script>

<%- include('_foot') %>
