<%- include('_head', { title, page, user, csrfToken }) %>

<div style="margin-bottom:16px;">
  <a href="/admin/properties" style="font-size:13px;color:var(--gray-mid);text-decoration:none;">
    <i class="fa-solid fa-arrow-left"></i> Back to Properties
  </a>
</div>

<% if (flash) { %>
<div class="alert alert-<%= flash.type === 'success' ? 'success' : 'error' %>">
  <i class="fa-solid fa-<%= flash.type === 'success' ? 'circle-check' : 'circle-exclamation' %>"></i>
  <%= flash.msg %>
</div>
<% } %>

<form method="POST"
      action="<%= property ? `/admin/properties/${property.id}` : '/admin/properties' %>"
      enctype="multipart/form-data"
      id="prop-form">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <input type="hidden" name="image_manifest" id="image-manifest-input">
  <input type="hidden" name="image_urls_json" id="image-urls-input">
  <input type="hidden" name="cover_position" id="cover-position-input">

  <!-- SECTION 1: Basic Info -->
  <div class="form-card">
    <div class="form-card-title"><i class="fa-solid fa-house" style="color:var(--blue-mid);margin-right:8px;"></i>Basic Information</div>
    <div class="form-row">
      <div class="form-group">
        <label for="title">Property Title *</label>
        <input type="text" id="title" name="title" required
               value="<%= property ? property.title : '' %>"
               placeholder="e.g. Shambo View"
               oninput="generateSlug(this.value)">
      </div>
      <div class="form-group">
        <label for="slug">URL Slug *</label>
        <input type="text" id="slug" name="slug"
               value="<%= property ? property.slug : '' %>"
               placeholder="e.g. shambo-view">
        <div class="form-hint">Auto-generated from title. Used in listing URL.</div>
      </div>
    </div>
    <div class="form-row-3">
      <div class="form-group">
        <label for="type">Listing Type</label>
        <select id="type" name="type">
          <option value="sale" <%= (!property || property.type === 'sale') ? 'selected' : '' %>>For Sale</option>
          <option value="rent" <%= (property && property.type === 'rent') ? 'selected' : '' %>>To Rent</option>
        </select>
      </div>
      <div class="form-group">
        <label for="status">Status</label>
        <select id="status" name="status">
          <option value="available"   <%= (!property || property.status === 'available')   ? 'selected' : '' %>>Available</option>
          <option value="under-offer" <%= (property && property.status === 'under-offer')  ? 'selected' : '' %>>Under Offer</option>
          <option value="sold"        <%= (property && property.status === 'sold')         ? 'selected' : '' %>>Sold</option>
          <option value="rented"      <%= (property && property.status === 'rented')       ? 'selected' : '' %>>Rented</option>
        </select>
      </div>
      <div class="form-group">
        <label for="contact_phone">Contact Phone</label>
        <input type="text" id="contact_phone" name="contact_phone"
               value="<%= property ? property.contact_phone : '0858196462' %>"
               placeholder="0858196462">
      </div>
    </div>
    <div class="form-group">
      <label for="location">Location *</label>
      <input type="text" id="location" name="location" required
             value="<%= property ? property.location : '' %>"
             placeholder="e.g. Okahandja, Namibia">
    </div>
    <div style="display:flex;gap:24px;flex-wrap:wrap;">
      <label class="form-check">
        <input type="checkbox" name="featured" <%= (property && property.featured) ? 'checked' : '' %>>
        <label><i class="fa-solid fa-star" style="color:var(--gold);"></i> Feature on Homepage</label>
      </label>
      <label class="form-check">
        <input type="checkbox" name="rental_option" <%= (property && property.rental_option) ? 'checked' : '' %>>
        <label>Rental Option Available</label>
      </label>
    </div>
  </div>

  <!-- SECTION 2: Pricing -->
  <div class="form-card">
    <div class="form-card-title"><i class="fa-solid fa-tag" style="color:var(--gold);margin-right:8px;"></i>Pricing</div>
    <div class="form-row">
      <div class="form-group">
        <label for="price">Price (N$) *</label>
        <input type="number" id="price" name="price" required min="0" step="0.01"
               value="<%= property ? property.price : '' %>"
               placeholder="400000">
      </div>
      <div class="form-group">
        <label for="levy">Monthly Levy (N$)</label>
        <input type="text" id="levy" name="levy"
               value="<%= property ? (property.levy || '') : '' %>"
               placeholder="e.g. 976.29 (leave blank if none)">
      </div>
    </div>
  </div>

  <!-- SECTION 3: Property Details -->
  <div class="form-card">
    <div class="form-card-title"><i class="fa-solid fa-list-check" style="color:var(--cyan);margin-right:8px;"></i>Property Details</div>
    <div class="form-row-3">
      <div class="form-group">
        <label for="bedrooms">Bedrooms</label>
        <input type="number" id="bedrooms" name="bedrooms" min="0"
               value="<%= property ? property.bedrooms : 0 %>">
      </div>
      <div class="form-group">
        <label for="bathrooms">Bathrooms</label>
        <input type="number" id="bathrooms" name="bathrooms" min="0"
               value="<%= property ? property.bathrooms : 0 %>">
      </div>
      <div class="form-group">
        <label for="units_available">Units Available</label>
        <input type="number" id="units_available" name="units_available" min="1"
               value="<%= property ? property.units_available : 1 %>">
      </div>
    </div>
  </div>

  <!-- SECTION 4: Description -->
  <div class="form-card">
    <div class="form-card-title"><i class="fa-solid fa-align-left" style="color:var(--navy-light);margin-right:8px;"></i>Description</div>
    <div class="form-group">
      <label for="description">Full Description</label>
      <textarea id="description" name="description" rows="8"
                placeholder="Describe the property, features, location highlights..."><%= property ? (property.description || '') : '' %></textarea>
    </div>
  </div>

  <!-- SECTION 5: Images -->
  <div class="form-card">
    <div class="form-card-title"><i class="fa-solid fa-images" style="color:var(--blue-mid);margin-right:8px;"></i>Photos</div>

    <% if (images && images.length > 0) { %>
    <div class="image-grid" id="image-grid">
      <% images.forEach(img => { %>
      <div class="image-item <%= img.is_cover ? 'is-cover' : '' %>" id="img-<%= img.id %>">
        <img src="<%= /^https?:\/\//i.test(img.filename) ? img.filename : '/' + img.filename %>" alt="Property photo">
        <% if (img.is_cover) { %><span class="cover-badge">Cover</span><% } %>
        <div class="image-actions">
          <% if (!img.is_cover) { %>
          <button type="button" title="Set as cover"
                  onclick="setCover('<%= property.id %>', '<%= img.id %>')">
            <i class="fa-solid fa-star"></i>
          </button>
          <% } %>
          <button type="button" title="Move up"
                  onclick="moveImage('<%= property.id %>', '<%= img.id %>', 'up')">
            <i class="fa-solid fa-arrow-left"></i>
          </button>
          <button type="button" title="Move down"
                  onclick="moveImage('<%= property.id %>', '<%= img.id %>', 'down')">
            <i class="fa-solid fa-arrow-right"></i>
          </button>
          <button type="button" class="danger" title="Delete"
                  onclick="deleteImage('<%= property.id %>', '<%= img.id %>')">
            <i class="fa-solid fa-trash"></i>
          </button>
        </div>
      </div>
      <% }) %>
    </div>
    <div style="margin-top:14px;font-size:12.5px;color:var(--gray-mid);">
      <i class="fa-solid fa-circle-info"></i>
      Gold border = cover photo shown on listing cards.
    </div>
    <div style="margin-top:20px;border-top:1px solid var(--gray-light);padding-top:16px;">
    <% } %>

    <div style="font-size:13px;font-weight:600;margin-bottom:10px;">Add Photos</div>

    <label class="upload-label" for="images">
      <i class="fa-solid fa-cloud-arrow-up"></i>
      <span>Upload from computer (JPEG, PNG, WebP &middot; max 5MB each)</span>
      <span style="font-size:11.5px;">Multiple files supported</span>
      <input type="file" id="images" name="images" multiple accept="image/jpeg,image/png,image/webp">
    </label>

    <div class="form-group" style="margin-top:16px;">
      <label for="image-url-input">Or add image by URL</label>
      <div class="hero-image-test-row">
        <input type="text" id="image-url-input" placeholder="https://images.unsplash.com/photo-...">
        <button type="button" class="btn btn-outline btn-sm" onclick="addUrlImage()">
          <i class="fa-solid fa-plus"></i> Add
        </button>
      </div>
      <div class="hero-image-test-preview" id="image-url-preview" style="display:none;"></div>
    </div>

    <div id="staged-image-list" class="img-stage-list"></div>
    <div id="staged-image-hint" style="display:none;font-size:12.5px;color:var(--gray-mid);margin-top:4px;">
      <i class="fa-solid fa-circle-info"></i>
      These photos are added when you save. Drag to reorder, or mark one as cover to override the existing cover photo.
    </div>

    <% if (images && images.length > 0) { %>
    </div>
    <% } %>
  </div>

  <!-- SUBMIT -->
  <div style="display:flex;gap:12px;">
    <button type="submit" class="btn btn-primary">
      <i class="fa-solid fa-floppy-disk"></i>
      <%= property ? 'Save Changes' : 'Create Property' %>
    </button>
    <a href="/admin/properties" class="btn btn-outline">Cancel</a>
    <% if (property) { %>
    <a href="/listing/<%= property.slug %>" target="_blank" class="btn btn-outline" style="margin-left:auto;">
      <i class="fa-solid fa-eye"></i> Preview Listing
    </a>
    <% } %>
  </div>
</form>

<script>
const CSRF = '<%= csrfToken %>';

function generateSlug(title) {
  const manualSlug = document.getElementById('slug');
  if (!manualSlug._touched) {
    manualSlug.value = title.toLowerCase()
      .replace(/[^a-z0-9\s-]/g, '')
      .trim()
      .replace(/[\s-]+/g, '-');
  }
}
document.getElementById('slug').addEventListener('input', function() {
  this._touched = true;
});
<% if (!property) { %>
document.getElementById('title').addEventListener('blur', function() {
  generateSlug(this.value);
});
<% } %>

async function postAction(url) {
  const res = await fetch(url, {
    method: 'POST',
    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
    body: `_csrf=${encodeURIComponent(CSRF)}`,
  });
  return res.json();
}

async function postActionWithBody(url, body) {
  const res = await fetch(url, {
    method: 'POST',
    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
    body: body + `&_csrf=${encodeURIComponent(CSRF)}`,
  });
  return res.json();
}

async function setCover(propId, imgId) {
  await postAction(`/admin/properties/${propId}/images/${imgId}/cover`);
  location.reload();
}

async function moveImage(propId, imgId, direction) {
  await postActionWithBody(`/admin/properties/${propId}/images/${imgId}/move`, `direction=${direction}`);
  location.reload();
}

async function deleteImage(propId, imgId) {
  if (!confirm('Delete this photo? This cannot be undone.')) return;
  await postAction(`/admin/properties/${propId}/images/${imgId}/delete`);
  document.getElementById(`img-${imgId}`)?.remove();
}

/* ── STAGED IMAGE LIST (new photos added this session, not yet saved) ── */
const HAS_EXISTING_IMAGES = <%= images && images.length > 0 ? 'true' : 'false' %>;
let stagedImages = []; // { id, kind: 'file'|'url', file?, url?, isCover }
let stagedSeq = 0;

function esc(s) {
  return String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

document.getElementById('images').addEventListener('change', function() {
  Array.from(this.files).forEach((file) => {
    stagedImages.push({ id: ++stagedSeq, kind: 'file', file, isCover: false });
  });
  renderStagedList();
});

function addUrlImage() {
  const input = document.getElementById('image-url-input');
  const url = input.value.trim();
  if (!/^https?:\/\//i.test(url)) {
    alert('Please enter a valid image URL starting with http:// or https://');
    return;
  }
  stagedImages.push({ id: ++stagedSeq, kind: 'url', url, isCover: false });
  input.value = '';
  document.getElementById('image-url-preview').style.display = 'none';
  renderStagedList();
}

// Preview the pasted URL on blur, before it's added to the list
document.getElementById('image-url-input').addEventListener('blur', function() {
  const url = this.value.trim();
  const box = document.getElementById('image-url-preview');
  box.classList.remove('error');
  if (!url) { box.style.display = 'none'; return; }
  box.style.display = 'block';
  box.innerHTML = '<img src="' + esc(url) + '" alt="Preview" ' +
    'onerror="this.parentNode.classList.add(\'error\');this.parentNode.textContent=\'Could not load image from this URL.\'" ' +
    'onload="this.parentNode.classList.remove(\'error\')">';
});

function setStagedCover(id) {
  stagedImages.forEach((img) => { img.isCover = img.id === id; });
  renderStagedList();
}

function removeStagedImage(id) {
  stagedImages = stagedImages.filter((img) => img.id !== id);
  renderStagedList();
}

function renderStagedList() {
  const list = document.getElementById('staged-image-list');
  const hint = document.getElementById('staged-image-hint');
  hint.style.display = stagedImages.length ? 'block' : 'none';

  list.innerHTML = stagedImages.map((img, i) => {
    const thumb = img.kind === 'file'
      ? '<img class="img-stage-thumb" src="' + URL.createObjectURL(img.file) + '" alt="">'
      : '<img class="img-stage-thumb" src="' + esc(img.url) + '" alt="" onerror="this.outerHTML=\'<div class=&quot;img-stage-thumb-broken&quot;><i class=&quot;fa-solid fa-triangle-exclamation&quot;></i></div>\'">';
    const label = img.kind === 'file' ? esc(img.file.name) : esc(img.url);
    const showsAsCoverByDefault = !HAS_EXISTING_IMAGES && i === 0 && !stagedImages.some((s) => s.isCover);
    const isCover = img.isCover || showsAsCoverByDefault;
    return (
      '<div class="img-stage-card" draggable="true" data-id="' + img.id + '">' +
        '<span class="img-stage-handle" title="Drag to reorder"><i class="fa-solid fa-grip-vertical"></i></span>' +
        thumb +
        '<span class="img-stage-label">' + label + '</span>' +
        '<div class="img-stage-actions">' +
          (isCover
            ? '<span class="img-stage-cover-pill"><i class="fa-solid fa-star"></i> Cover</span>'
            : '<button type="button" class="btn btn-sm btn-outline" onclick="setStagedCover(' + img.id + ')">Set as Cover</button>') +
          '<button type="button" class="btn btn-sm btn-danger" onclick="removeStagedImage(' + img.id + ')"><i class="fa-solid fa-trash"></i></button>' +
        '</div>' +
      '</div>'
    );
  }).join('');

  wireStagedDragHandlers();
}

function wireStagedDragHandlers() {
  const cards = document.querySelectorAll('.img-stage-card');
  let dragEl = null;
  cards.forEach((card) => {
    card.addEventListener('dragstart', () => {
      dragEl = card;
      card.classList.add('dragging');
    });
    card.addEventListener('dragend', () => {
      card.classList.remove('dragging');
      syncStagedOrderFromDom();
    });
    card.addEventListener('dragover', (e) => {
      e.preventDefault();
      if (card === dragEl) return;
      const rect = card.getBoundingClientRect();
      const before = (e.clientY - rect.top) < rect.height / 2;
      card.parentNode.insertBefore(dragEl, before ? card : card.nextSibling);
    });
  });
}

function syncStagedOrderFromDom() {
  const ids = Array.from(document.querySelectorAll('.img-stage-card')).map((c) => parseInt(c.dataset.id, 10));
  stagedImages.sort((a, b) => ids.indexOf(a.id) - ids.indexOf(b.id));
}

// Build the manifest + rebuild the file input's FileList to match the
// staged order, then let the native form submission carry everything.
document.getElementById('prop-form').addEventListener('submit', function() {
  const manifest = stagedImages.map((img) => ({ kind: img.kind }));
  const urls = stagedImages.filter((img) => img.kind === 'url').map((img) => img.url);

  const dt = new DataTransfer();
  stagedImages.filter((img) => img.kind === 'file').forEach((img) => dt.items.add(img.file));
  document.getElementById('images').files = dt.files;

  let coverPosition = stagedImages.findIndex((img) => img.isCover);
  if (coverPosition === -1 && !HAS_EXISTING_IMAGES && stagedImages.length > 0) coverPosition = 0;

  document.getElementById('image-manifest-input').value = JSON.stringify(manifest);
  document.getElementById('image-urls-input').value = JSON.stringify(urls);
  document.getElementById('cover-position-input').value = coverPosition >= 0 ? String(coverPosition) : '';
});
</script>

<%- include('_foot') %>
