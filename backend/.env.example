# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# Server
PORT=
NODE_ENV=

# Session secret — generate a strong random string (e.g. openssl rand -hex 32)
SESSION_SECRET=

# Initial admin user created by the seed script
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Namhost cPanel SMTP — typically mail.[yourdomain], or the server
# hostname if that doesn't work. Two separate inboxes/credentials since
# mail sends FROM each division's own address.
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASS=
MAIL_USER_INSURANCE=
MAIL_PASS_INSURANCE=
